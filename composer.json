{
    "name": "majid-shafik/filament-table-drag-scroll",
    "description": "Grab and drag horizontally scrollable Filament tables with a mouse.",
    "type": "library",
    "keywords": [
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "table",
        "drag-scroll",
        "grab-scroll"
    ],
    "homepage": "https://github.com/Majid-Shafik/filament-table-drag-scroll",
    "support": {
        "issues": "https://github.com/Majid-Shafik/filament-table-drag-scroll/issues",
        "source": "https://github.com/Majid-Shafik/filament-table-drag-scroll"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Majid Shafik",
            "homepage": "https://github.com/Majid-Shafik",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "MajidShafik\\FilamentTableDragScroll\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MajidShafik\\FilamentTableDragScroll\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "test": "pest",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MajidShafik\\FilamentTableDragScroll\\FilamentTableDragScrollServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
